#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VENV_PATH="${PROJECT_ROOT}/.venv-bmad"
PYTHON_BIN="${VENV_PATH}/bin/python"
PIP_BIN="${VENV_PATH}/bin/pip"
REQUIREMENTS_FILE="${PROJECT_ROOT}/.github/skills/bmad-init/requirements.txt"
TARGET_SCRIPT="${PROJECT_ROOT}/.github/skills/bmad-init/scripts/bmad_init.py"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  python3 -m venv "${VENV_PATH}"
fi

if ! "${PYTHON_BIN}" -c 'import yaml' >/dev/null 2>&1; then
  "${PIP_BIN}" install --requirement "${REQUIREMENTS_FILE}"
fi

exec "${PYTHON_BIN}" "${TARGET_SCRIPT}" "$@"