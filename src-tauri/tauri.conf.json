{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Solo Compose/covers/**"
        ]
      },
      "csp": null
    },
    "windows": [
      {
        "acceptFirstMouse": true,
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": false,
        "height": 600,
        "maximized": true,
        "minWidth": 1300,
        "theme": "Dark",
        "title": "Solo Compose",
        "titleBarStyle": "Overlay",
        "transparent": true,
        "url": "index.html",
        "width": 800
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.14"
    },
    "targets": "dmg"
  },
  "identifier": "com.soloapps.compose",
  "productName": "Solo Compose",
  "version": "1.25.1"
}