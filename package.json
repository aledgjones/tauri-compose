{
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "big.js": "7.0.1",
    "classnames": "2.5.1",
    "pretty-ms": "9.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-inspector": "9.0.0",
    "sortablejs": "1.15.6"
  },
  "devDependencies": {
    "@nabla/vite-plugin-eslint": "^2.0.6",
    "@tailwindcss/postcss": "4.1.18",
    "@tauri-apps/cli": "2.10.0",
    "@types/big.js": "6.2.2",
    "@types/node": "25.2.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/sortablejs": "1.15.9",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vitejs/plugin-react": "5.1.3",
    "archiver": "^7.0.1",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "17.3.0",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "name": "compose",
  "overrides": {
    "react-inspector": {
      "react": "^19.0.0"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate-manifest": "./scripts/generate-manifest",
    "generate-manifest:build": "cd src-tauri && cargo build --release --bin generate-manifest && cp target/release/generate-manifest ../scripts/generate-manifest",
    "generate-scvi": "./scripts/scvi-compress",
    "generate-scvi:build": "cd src-tauri && cargo build --release --bin scvi-compress && cp target/release/scvi-compress ../scripts/scvi-compress",
    "inspect-scvi": "./scripts/scvi-inspect",
    "inspect-scvi:build": "cd src-tauri && cargo build --release --bin scvi-inspect && cp target/release/scvi-inspect ../scripts/scvi-inspect",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "preview": "vite preview",
    "release:build": "cd src-tauri && cargo build --release --bin release && cp target/release/release ../scripts/release",
    "release:major": "./scripts/release major",
    "release:minor": "./scripts/release minor",
    "release:patch": "./scripts/release patch",
    "start:dev": "tauri dev",
    "start:release": "tauri build",
    "tauri": "tauri"
  },
  "type": "module",
  "version": "1.20.3"
}