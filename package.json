{
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "big.js": "7.0.1",
    "classnames": "2.5.1",
    "pretty-ms": "9.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-inspector": "9.0.0",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@nabla/vite-plugin-eslint": "^2.0.6",
    "@tailwindcss/postcss": "4.2.0",
    "@tauri-apps/cli": "2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/big.js": "6.2.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "archiver": "^7.0.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "17.3.0",
    "happy-dom": "^20.8.3",
    "lint-staged": "^16.3.2",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{json,md,css,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "name": "compose",
  "overrides": {
    "react-inspector": {
      "react": "^19.0.0"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate-manifest": "./scripts/generate-manifest",
    "generate-manifest:build": "cd src-tauri && cargo build --release --bin generate-manifest && cp target/release/generate-manifest ../scripts/generate-manifest",
    "generate-scvi": "./scripts/scvi-compress",
    "generate-scvi:build": "cd src-tauri && cargo build --release --bin scvi-compress && cp target/release/scvi-compress ../scripts/scvi-compress",
    "inspect-scvi": "./scripts/scvi-inspect",
    "inspect-scvi:build": "cd src-tauri && cargo build --release --bin scvi-inspect && cp target/release/scvi-inspect ../scripts/scvi-inspect",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "prepare": "simple-git-hooks || true",
    "preview": "vite preview",
    "release:build": "cd src-tauri && cargo build --release --bin release && cp target/release/release ../scripts/release",
    "release:major": "./scripts/release major",
    "release:minor": "./scripts/release minor",
    "release:patch": "./scripts/release patch",
    "start:dev": "tauri dev",
    "start:release": "tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "cd src-tauri && cargo llvm-cov --lib --fail-under-lines 10 --fail-under-functions 30 --fail-under-regions 15",
    "test:coverage:rust:summary": "cd src-tauri && cargo llvm-cov --lib",
    "test:coverage:summary": "node -e \"const data=require('./coverage/coverage-final.json');let ts=0,cs=0,tb=0,cb=0,tf=0,cf=0;for(const f of Object.values(data)){const s=f.s||{},b=f.b||{},fn=f.f||{};ts+=Object.keys(s).length;cs+=Object.values(s).filter(v=>v>0).length;for(const vals of Object.values(b)){tb+=vals.length;cb+=vals.filter(v=>v>0).length;}tf+=Object.keys(fn).length;cf+=Object.values(fn).filter(v=>v>0).length;}console.log('Statements: '+cs+'/'+ts+' = '+(cs/ts*100).toFixed(1)+'%');console.log('Branches:   '+cb+'/'+tb+' = '+(cb/tb*100).toFixed(1)+'%');console.log('Functions:  '+cf+'/'+tf+' = '+(cf/tf*100).toFixed(1)+'%');\"",
    "test:logs": "VITEST_LOGS=1 vitest run",
    "test:logs:watch": "VITEST_LOGS=1 vitest",
    "test:watch": "vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "type": "module",
  "version": "1.23.3"
}
