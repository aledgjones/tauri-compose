{
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "big.js": "7.0.1",
    "classnames": "2.5.1",
    "pretty-ms": "9.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-inspector": "9.0.0",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@nabla/vite-plugin-eslint": "3.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/big.js": "6.2.2",
    "@types/node": "25.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "archiver": "^7.0.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "happy-dom": "^20.8.3",
    "lint-staged": "^16.3.2",
    "postcss": "8.5.8",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{json,md,css,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "name": "compose",
  "overrides": {
    "react-inspector": {
      "react": "^19.0.0"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "finalize-release": "./scripts/release finalize",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate-manifest": "./scripts/generate-manifest",
    "generate-manifest:build": "cd src-tauri && cargo build --release --bin generate-manifest && cp target/release/generate-manifest ../scripts/generate-manifest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "perf:render": "cd src-tauri && cargo run --release --bin performance --",
    "prepare": "simple-git-hooks || true",
    "prepare-release:major": "./scripts/release prepare major",
    "prepare-release:minor": "./scripts/release prepare minor",
    "prepare-release:patch": "./scripts/release prepare patch",
    "preview": "vite preview",
    "release:build": "cd src-tauri && cargo build --release --bin release && cp target/release/release ../scripts/release",
    "start:dev": "tauri dev",
    "start:release": "tauri build",
    "tauri": "tauri",
    "test:js": "vitest run",
    "test:js:coverage": "vitest run --coverage",
    "test:js:coverage:summary": "./scripts/coverage-summary",
    "test:js:logs": "VITEST_LOGS=1 vitest run",
    "test:js:logs:watch": "VITEST_LOGS=1 vitest",
    "test:js:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:rust:coverage": "cd src-tauri && cargo llvm-cov --lib --fail-under-lines 62 --fail-under-functions 76 --fail-under-regions 65",
    "test:rust:coverage:summary": "cd src-tauri && cargo llvm-cov --lib"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "type": "module",
  "version": "2.1.0"
}
